// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String  @id @default(uuid())
  email            String  @unique
  nombre           String
  contraseña      String?
  emailVerified    Boolean @default(false)
  image            String?
  estado           Boolean @default(true)
  telefono         String?
  username         String? @unique
  displayUsername  String?
  twoFactorEnabled Boolean @default(false)

  tareas         TareaProgramada[]
  tareasRadicado TareaProgramadaRadicado[]
  accounts       Account[]
  sessions       Session[]
  twofactors     TwoFactor[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("users")
}

model TwoFactor {
  id          String  @id @default(uuid())
  secret      String
  backupCodes String
  verified    Boolean @default(false)
  userId      String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factors")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accounts")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verifications")
}

model TareaProgramada {
  id            String   @id @default(uuid())
  parteProcesal String[]
  juzgado       String
  frecuencia    String
  activa        Boolean  @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  procesos ProcesosJudiciales[]

  ultimaEjecucion DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@map("tareas_programadas")
}

model ProcesosJudiciales {
  id                  String   @id @default(uuid())
  radicado            String
  tipoProceso         String?
  ponente             String?
  demandante          String?
  demandado           String?
  textoCompleto       String?
  fechaDescubrimiento DateTime @default(now())

  // DETALLES 

  corporacion       String?
  clase             String?
  subclase          String?
  marcoLegal        String?
  vigente           Boolean?
  salaConoce        String?
  salaDecide        String?
  fechaRadicado     DateTime?
  fechaPresentacion DateTime?
  sentencia         String?
  asunto            String?
  origen            String?
  recurso           String?
  naturaleza        String?
  ubicacion         String?
  etapa             String?
  formatoExpediente String?
  detalleExtraido   Boolean   @default(false)

  tareaProgramadaId String?
  tareaProgramada   TareaProgramada? @relation(fields: [tareaProgramadaId], references: [id], onDelete: SetNull)

  tareaProgramadaRadicadoId String?
  tareaProgramadaRadicado   TareaProgramadaRadicado? @relation(fields: [tareaProgramadaRadicadoId], references: [id], onDelete: SetNull)

  actuaciones Actuacion[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("procesos_judiciales")
}

model Actuacion {
  id             String    @id @default(uuid())
  fechaRegistro  DateTime?
  fechaActuacion DateTime?
  actuacion      String?
  anotacion      String?
  estado         String?
  anexos         Int       @default(0)
  indice         String?

  procesoId String
  proceso   ProcesosJudiciales @relation(fields: [procesoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([procesoId, indice])
  @@map("actuaciones")
}

model TareaProgramadaRadicado {
  id         String  @id @default(uuid())
  radicado   String
  juzgado    String
  frecuencia String
  activa     Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  procesos ProcesosJudiciales[]

  ultimaEjecucion DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  @@unique([userId, radicado])
  @@map("tareas_programadas_radicado")
}
